{
  "name": "loan-data-analysis",
  "version": "1.1.0",
  "private": true,
  "description": "CSV validation, overdue-loan analysis and source-row evidence with a browser UI and reproducible CLI.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "example": "node scripts/analyze.cjs --input examples/loans.csv --as-of 2026-10-28 --min-days 30",
    "compare": "node scripts/analyze.cjs --input examples/loans.csv --previous examples/loans-previous.csv --as-of 2026-10-28 --min-days 30"
  }
}
